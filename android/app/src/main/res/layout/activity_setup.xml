<?xml version="1.0" encoding="utf-8"?>
<!-- Padding leaves an overscan safe area: some TVs and projectors crop the edges. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navis_background"
    android:paddingLeft="56dp"
    android:paddingTop="32dp"
    android:paddingRight="56dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/navis_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_server_label"
            android:textColor="@color/navis_text_secondary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/server_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/setup_server_hint"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:textColor="@color/navis_text_primary"
            android:textColorHint="@color/navis_text_muted"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setup_server_help"
            android:textColor="@color/navis_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_password_label"
            android:textColor="@color/navis_text_secondary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/setup_password_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:textColor="@color/navis_text_primary"
            android:textColorHint="@color/navis_text_muted"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/start_on_boot_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_start_on_boot"
            android:textColor="@color/navis_text_primary"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/low_performance_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_low_performance"
            android:textColor="@color/navis_text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_scale_label"
            android:textColor="@color/navis_text_secondary"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/render_scale_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minWidth="220dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setup_scale_help"
            android:textColor="@color/navis_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_preview_label"
            android:textColor="@color/navis_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/url_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/navis_surface"
            android:padding="12dp"
            android:textColor="@color/navis_accent"
            android:textIsSelectable="false"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="@string/setup_cancel"
                android:textSize="16sp" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:minWidth="160dp"
                android:text="@string/setup_save"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
