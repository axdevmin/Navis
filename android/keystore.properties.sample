# Copy to android/keystore.properties (gitignored) to sign release APKs.
#
# Create the keystore once, then keep it somewhere safe and backed up: losing
# it means you can no longer ship an update over an already installed app.
#
#   keytool -genkeypair -v \
#     -keystore ~/navis-tv-release.jks \
#     -alias navis-tv \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Without this file the release APK is signed with the debug key. It installs
# fine for local sideloading, but do not distribute it.

storeFile=/absolute/path/to/navis-tv-release.jks
storePassword=changeme
keyAlias=navis-tv
keyPassword=changeme
