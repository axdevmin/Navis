#!/bin/sh
#
# Minimal Gradle wrapper launcher. It does exactly what the generated script
# does -- run GradleWrapperMain from the wrapper jar -- without vendoring
# several hundred lines of shell into the repository.
#
set -e

DIR=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "gradle-wrapper.jar is missing at $WRAPPER_JAR" >&2
    exit 1
fi

if [ -n "$JAVA_HOME" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD=$(command -v java || true)
fi

if [ -z "$JAVA_CMD" ] || [ ! -x "$JAVA_CMD" ]; then
    echo "No Java runtime found. Set JAVA_HOME to a JDK 17 or 21 install." >&2
    exit 1
fi

exec "$JAVA_CMD" -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
